# --- docker-compose secrets ---
UNIFI_CLOUD_API_KEY=your-cloud-api-key
UNIFI_LOCAL_API_KEY=your-local-api-key
UNIFI_LOCAL_IP=local-ip-of-unifi-controller

# Optional: bearer token required on all /api/* routes (leave unset to disable auth)
DASHBOARD_TOKEN=your-secret-token

# Optional: dashboard header + browser tab title (default: "Used IT Tech @ Home")
# APP_TITLE=Used IT Tech @ Home

# Optional: path to UniFi controller CA cert PEM for proper TLS verification
# UNIFI_LOCAL_CA=/run/secrets/unifi-ca.pem

# Optional: comma-separated CIDRs allowed to reach the whole app (see
# app/src/middleware.ts). Leave unset to allow only loopback (localhost) —
# nothing else can reach the app until this is set.
# Include 172.16.0.0/12 if running via docker-compose.yaml locally: Docker
# Desktop's published-port forwarding makes the browser's request appear to
# originate from the compose project's bridge gateway (e.g. 172.19.0.1),
# not loopback, so it needs to be allowlisted explicitly.
ALLOWED_NETWORKS=172.16.0.0/12

# Optional: Microsoft Entra ID SSO (see app/src/auth.ts). Layers on top of
# ALLOWED_NETWORKS above — both must pass, SSO doesn't replace it. Leave any
# of the three AUTH_MICROSOFT_ENTRA_ID_* values unset to keep SSO fully
# disabled — the app then behaves exactly as if this section didn't exist.
#
# Get clientId/clientSecret/tenant from an app registration in the Entra
# admin center (Certificates & secrets for the client secret). Register the
# redirect URI <your-app-url>/api/auth/callback/microsoft-entra-id there.
# AUTH_MICROSOFT_ENTRA_ID_ID=your-app-registration-client-id
# AUTH_MICROSOFT_ENTRA_ID_SECRET=your-app-registration-client-secret
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
# Random signing key for the session JWT — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_SECRET=generate-a-random-value
# Optional comma-separated allowlist. Leave empty/unset to allow any account
# in the tenant (the tenant itself is still the boundary via the app registration).
# AUTH_ALLOWED_EMAILS=you@example.com

# --- Optional: Platforms Monitor tab (MCP servers) ---
# Each source is independently optional — the tab shows a "not reachable"
# state per source if its URL is unset or the server can't be reached.
# Credentials for these servers are never stored in this repo: Home
# Assistant's token and the Kubernetes kubeconfig live on the MCP host
# itself (see docker-compose.mcp.yaml), and the GitHub PAT below is the
# only secret this app itself holds (sent as a per-request header, never
# written to a file).
#
# MCP_HOST is where kubernetes-mcp-server / github-mcp-server / ha-mcp run
# (see docker-compose.mcp.yaml, meant to run dedicated on docker-server).
# docker-compose.yaml/.dev.yaml build MCP_*_URL from MCP_HOST automatically;
# set MCP_KUBERNETES_URL/MCP_GITHUB_URL/MCP_HOMEASSISTANT_URL individually
# only if a source lives somewhere other than MCP_HOST.
MCP_GITHUB_TOKEN=your-github-pat
MCP_HOST=host.docker.internal
MCP_KUBERNETES_URL=http://${MCP_HOST}:8087/mcp
MCP_GITHUB_URL=http://${MCP_HOST}:8082/mcp
MCP_HOMEASSISTANT_URL=http://${MCP_HOST}:8086/mcp

# --- Secrets for docker-compose.mcp.yaml (only needed when running that
# dedicated MCP stack, typically on docker-server) ---
HOMEASSISTANT_URL=https://your-home-assistant-url
HOMEASSISTANT_TOKEN=your-home-assistant-long-lived-token
# Path (on the host running docker-compose.mcp.yaml) to a kubeconfig with
# read access to the cluster
KUBECONFIG_PATH=./kubeconfig

# --- Optional: Home tab favorite-app links ---
# Each link is HOME_LINK_<N>_TITLE/_LABEL/_URL/_NOTE (NOTE optional), N=0..
# Entries sharing the same TITLE are grouped together in the UI. No built-in
# default — the Home tab shows no links until at least HOME_LINK_0_* is set.
HOME_LINK_0_TITLE=MY LINKS
HOME_LINK_0_LABEL=Google
HOME_LINK_0_URL=https://google.com
HOME_LINK_0_NOTE=Google
HOME_LINK_1_TITLE=MY LINKS
HOME_LINK_1_LABEL=Test
HOME_LINK_1_URL=https://test.com
HOME_LINK_1_NOTE=Test