{
  "mcpServers": {
    "unifi Local": {
      "command": "unifi-mcp-server",
      "env": {
        "UNIFI_API_KEY": "<your-local-api-key>",
        "UNIFI_API_TYPE": "local",
        "UNIFI_LOCAL_HOST": "<your-controller-ip-or-hostname>"
      }
    },
    "unifi Cloud": {
      "command": "unifi-mcp-server",
      "env": {
        "UNIFI_API_KEY": "<your-cloud-api-key>",
        "UNIFI_API_TYPE": "cloud-v1"
      }
    }
  }
}
