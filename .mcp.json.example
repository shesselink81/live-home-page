{
  "mcpServers": {
    "unifi Cloud": {
      "command": "unifi-mcp-server",
      "env": {
        "UNIFI_API_KEY": "<your-cloud-api-key>",
        "UNIFI_API_TYPE": "cloud-v1"
      }
    },
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp?codemode=false"
    },
    "unifi-network": {
      "type": "http",
      "url": "http://localhost:8088/mcp"
    },
    "home-assistant": {
      "type": "http",
      "url": "http://localhost:8086/mcp"
    },
    "kubernetes": {
      "type": "http",
      "url": "http://localhost:8087/mcp"
    },
    "github-local": {
      "type": "http",
      "url": "http://localhost:8082/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_GITHUB_TOKEN}"
      }
    }
  }
}
